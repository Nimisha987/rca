# Copy to .env and fill in. Get a key at https://console.groq.com/keys
GROQ_API_KEY=

# Models (any Groq-supported chat model that supports tool calling works)
GROQ_MODEL_REASONING=llama-3.3-70b-versatile
GROQ_MODEL_EXTRACT=llama-3.3-70b-versatile

# PostgreSQL (docker compose up -d db) -- sqlite works for quick local tests:
# DATABASE_URL=sqlite:///./rca.db
DATABASE_URL=postgresql+psycopg2://rca:rca@localhost:5432/rca

CORS_ORIGINS=http://localhost:5173
